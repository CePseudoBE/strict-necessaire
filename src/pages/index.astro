---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Refus from "../components/Refus.astro";
import Artemis from "../components/Artemis.astro";
import Duo from "../components/Duo.astro";
import Contact from "../components/Contact.astro";
import { translations } from "../i18n/ui";

const t = translations(Astro.currentLocale);
---

<Base>
  <Hero />
  <main class="wrap" id="content" tabindex="-1">
    <Refus />
    <Artemis />
    <Duo />
    <Contact />
  </main>
  <footer class="wrap">{t.footer}</footer>
</Base>
