---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import desk from "../assets/img/hero.png";

const frames = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/img/tampon/*.png",
  { eager: true },
);
const directions = ["nw", "n", "ne", "w", "c", "e", "sw", "s", "se"];
---

<header class="hero-band" data-theme="light">
  <Image
    class="desk"
    src={desk}
    alt=""
    widths={[640, 960, 1280, 1672]}
    sizes="(min-width: 961px) 114vw, 250vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="inner">
    <nav aria-label="Navigation principale">
      <a class="brand" href="#top">
        Le Strict Nécessaire<span>.</span>
      </a>
      <ul>
        <li>
          <a href="#refus">Ce qu'on refuse</a>
        </li>
        <li>
          <a href="#artemis">Artemis</a>
        </li>
        <li>
          <a href="#nous">Nous deux</a>
        </li>
        <li>
          <a href="#contact">Contact</a>
        </li>
      </ul>
    </nav>

    <div class="hero" id="top">
      <div class="hero-text">
        <p class="label">Studio IA à deux · Bruxelles</p>
        <h1>
          L'IA, mais <mark>seulement</mark> là où il en faut.
        </h1>
        <p class="lead">
          On construit des outils qui font à votre place le travail long,
          répétitif et vérifiable. Si un tableur suffit, on vous le dit et on ne
          vous facture pas d'IA.
        </p>
        <a class="cta" href="#contact">
          Montrez-nous votre tâche pénible
        </a>
      </div>

      <div class="demo">
        <div
          class="sheet"
          aria-label="Démonstration : une demande client analysée contre des PV"
        >
          <div class="sheet-head">
            <span>De : bureau d'études</span>
            <span>Objet : demande de prix, 14 blocs-portes</span>
          </div>
          <p class="mail">
            Bonjour, pour le chantier de l'école, il nous faudrait :
          </p>
          <ul class="reqs" id="reqs">
            <li>
              <span>
                <span class="req">résistance au feu EI1 30</span>
              </span>
              <span class="verdict ok">Couvert · PV 114</span>
            </li>
            <li>
              <span>
                <span class="req">vantail de 1030 x 2315 mm</span>
              </span>
              <span class="verdict ok">Couvert · PV 114</span>
            </li>
            <li>
              <span>
                <span class="req">oculus vitré 400 x 600 mm</span>
              </span>
              <span class="verdict warn">Une question au spécialiste</span>
            </li>
            <li>
              <span>
                <span class="req">ferme-porte encastré</span>
              </span>
              <span class="verdict no">Hors PV choisis</span>
            </li>
            <li>
              <span>
                <span class="req">finition stratifiée chêne</span>
              </span>
              <span class="verdict ok">Sans incidence</span>
            </li>
          </ul>
          <div class="stamp" id="stamp">
            Analysé · 5 exigences · 1 question
          </div>
          <div class="sheet-foot">
            <span>Exemple inventé pour la démonstration.</span>
            <button class="ghost" id="replay" type="button">
              Rejouer
            </button>
          </div>
        </div>

        <div class="tampon" aria-hidden="true">
          {directions.map((direction) => (
            <Image
              src={
                frames[`../assets/img/tampon/tampon-${direction}.png`].default
              }
              alt=""
              widths={[240, 400]}
              sizes="(min-width: 961px) 22vw, 150px"
              loading={direction === "c" ? "eager" : "lazy"}
              data-lean={direction}
              class:list={{ on: direction === "c" }}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<script src="../scripts/hero-demo.ts"></script>
<script src="../scripts/tampon.ts"></script>

<style>
  .hero-band {
    container: hero / inline-size;
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: linear-gradient(#f8ebdb 55%, #dcc6af);
    color: var(--ink);
  }
  .desk {
    position: absolute;
    inset: 0 auto auto 0;
    z-index: -1;
    width: 250%;
    max-width: none;
    mask-image: linear-gradient(#000 60%, transparent);
  }
  .inner {
    display: flex;
    flex-direction: column;
    width: min(1120px, 100% - 2 * clamp(16px, 5vw, 56px));
    margin-inline: auto;
    padding-bottom: clamp(56px, 8vw, 104px);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    align-items: start;
    justify-content: space-between;
  }
  .brand {
    margin-top: 18px;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.3rem;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .brand span {
    color: var(--stamp);
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav ul a {
    display: block;
    padding: 22px 16px 10px;
    border-radius: 0 0 3px 3px;
    background: var(--paper);
    box-shadow: 0 2px 6px -2px rgb(60 40 20 / 0.35);
    font-weight: 600;
    text-decoration: none;
    translate: 0 -6px;
    transition: translate 0.2s;
  }
  nav ul a:hover {
    translate: 0 0;
  }

  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 72px;
    margin-top: clamp(32px, 6vw, 72px);
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero-text .label {
    color: var(--ink);
  }
  .hero-text .lead {
    font-size: 1.2rem;
  }
  .cta {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--display);
    font-weight: 600;
    text-decoration: none;
    background: var(--ink);
    color: var(--bg);
    padding: 14px 22px;
    border-radius: 2px;
  }
  .cta:hover {
    background: var(--hl);
    color: var(--on-hl);
  }

  .demo {
    position: relative;
  }
  .sheet {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(18px, 3vw, 30px);
    background:
      linear-gradient(rgb(228 236 223 / 0.84), rgb(228 236 223 / 0.84)),
      var(--texture) center / 600px;
    transform: rotate(-1.2deg);
    box-shadow:
      0 1px 2px rgb(60 40 20 / 0.2),
      0 18px 40px -18px rgb(60 40 20 / 0.5);
  }
  .sheet-head {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 0.78em;
    color: var(--muted);
    border-bottom: 1px dashed color-mix(in srgb, var(--ink) 25%, transparent);
    padding-bottom: 12px;
  }
  .reqs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .reqs li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 14px;
    align-items: baseline;
  }
  .req {
    --p: 1;
    background-image: linear-gradient(var(--hl), var(--hl));
    background-repeat: no-repeat;
    background-size: calc(var(--p) * 100%) 100%;
    color: color-mix(in srgb, var(--on-hl) calc(var(--p) * 100%), var(--ink));
    padding: 0.05em 0.25em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .verdict {
    font-family: var(--mono);
    font-size: 0.76em;
    white-space: nowrap;
  }
  .verdict.ok {
    color: var(--ok);
  }
  .verdict.warn {
    color: var(--warn);
  }
  .verdict.no {
    color: var(--no);
  }
  .stamp {
    align-self: flex-end;
    margin-top: auto;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.8em;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--stamp);
    border: 2px solid var(--stamp);
    border-radius: 4px;
    padding: 8px 12px;
    transform: rotate(-4deg);
  }
  .sheet-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8em;
    color: var(--muted);
  }

  .tampon {
    position: absolute;
    right: -12px;
    top: -92px;
    width: 150px;
    aspect-ratio: 1;
    pointer-events: none;
  }
  .tampon img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .tampon img:not(.on) {
    visibility: hidden;
  }

  @container hero (width > 960px) {
    .desk,
    .inner {
      --u: min(1cqw, 1.55svh, 16px);
    }
    .desk {
      left: calc(100cqw - 100 * var(--u));
      width: calc(114 * var(--u));
      mask-image: linear-gradient(to right, transparent, #000 8%);
    }
    .inner {
      min-height: calc(62 * var(--u));
    }
    .hero-text {
      width: calc(
        100cqw - 53 * var(--u) -
          max(clamp(16px, 5cqw, 56px), (100cqw - 1120px) / 2)
      );
    }
    .hero-text h1 {
      font-size: clamp(2.7rem, 6.2 * var(--u), 6.2rem);
    }
    .demo {
      position: absolute;
      left: calc(100cqw - 49.3 * var(--u));
      top: calc(7.7 * var(--u));
      width: calc(45 * var(--u));
    }
    .sheet {
      min-height: calc(52 * var(--u));
      padding: calc(3.2 * var(--u));
      font-size: clamp(1rem, 1.6 * var(--u), 1.35rem);
      transform: rotate(-1.7deg);
    }
    .reqs li {
      grid-template-columns: max-content minmax(0, 1fr);
    }
    .req {
      white-space: nowrap;
    }
    .verdict {
      justify-self: end;
      text-align: right;
      white-space: normal;
    }
    .tampon {
      left: calc(-14 * var(--u));
      right: auto;
      top: calc(30 * var(--u));
      width: calc(22 * var(--u));
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .req {
      --p: 0;
    }
    :global(.js) .verdict,
    :global(.js) .stamp {
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    nav ul a {
      transition: none;
    }
  }
  @media (hover: none), (pointer: coarse) {
    .tampon img:not(.on) {
      display: none;
    }
  }
  @media (max-width: 600px) {
    nav {
      flex-direction: column-reverse;
      gap: 20px;
    }
    nav ul {
      gap: 4px;
      font-size: 0.82rem;
    }
    nav ul a {
      padding: 20px 8px 7px;
    }
    .brand {
      margin-top: 0;
    }
  }
  @media (max-width: 480px) {
    .reqs li {
      grid-template-columns: minmax(0, 1fr);
    }
    .verdict {
      white-space: normal;
    }
  }
</style>
