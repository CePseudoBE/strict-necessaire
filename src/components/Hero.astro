---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import desk from "../assets/img/hero.png";
import { translations } from "../i18n/ui";

const frames = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/img/tampon/*.png",
  { eager: true },
);
const directions = ["nw", "n", "ne", "w", "c", "e", "sw", "s", "se"];
const t = translations(Astro.currentLocale);
const otherLocale = Astro.currentLocale === "en" ? "fr" : "en";
---

<header class="hero-band" data-theme="light">
  <Image
    class="desk"
    src={desk}
    alt=""
    widths={[640, 960, 1280, 1672]}
    quality={75}
    sizes="(min-width: 961px) 114vw, 250vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="inner">
    <nav aria-label={t.nav.label}>
      <a class="brand" href="#top">
        Le Strict Nécessaire<span>.</span>
      </a>
      <ul>
        <li>
          <a class="tab" href="#refus">
            {t.nav.refus}
          </a>
        </li>
        <li>
          <a class="tab" href="#artemis">
            {t.nav.artemis}
          </a>
        </li>
        <li>
          <a class="tab" href="#nous">
            {t.nav.duo}
          </a>
        </li>
        <li>
          <a class="tab" href="#contact">
            {t.nav.contact}
          </a>
        </li>
      </ul>
      <a
        class="tab lang"
        href={getRelativeLocaleUrl(otherLocale)}
        hreflang={otherLocale}
        lang={otherLocale}
        aria-label={`${t.nav.switchText}, ${t.nav.switchLabel}`}
      >
        {t.nav.switchText}
      </a>
    </nav>

    <div class="hero" id="top">
      <div class="hero-text">
        <p class="label">{t.hero.label}</p>
        <h1>
          {t.hero.titleBefore} <mark>{t.hero.titleMark}</mark>{" "}
          {t.hero.titleAfter}
        </h1>
        <p class="lead">{t.hero.lead}</p>
        <a class="cta" href="#contact">
          {t.hero.cta}
        </a>
      </div>

      <div class="demo">
        <div class="sheet" role="figure" aria-label={t.hero.demoLabel}>
          <div class="sheet-head">
            <span>{t.hero.from}</span>
            <span>{t.hero.subject}</span>
          </div>
          <p class="mail">{t.hero.greeting}</p>
          <ul class="reqs" id="reqs">
            {t.hero.requirements.map((requirement) => (
              <li>
                <span>
                  <span class="req">{requirement.text}</span>
                </span>
                <span class:list={["verdict", requirement.status]}>
                  {requirement.verdict}
                </span>
              </li>
            ))}
          </ul>
          <div class="stamp" id="stamp">
            {t.hero.stamp}
          </div>
          <div class="sheet-foot">
            <span>{t.hero.disclaimer}</span>
            <button class="ghost" id="replay" type="button">
              {t.hero.replay}
            </button>
          </div>
        </div>

        <div class="tampon" aria-hidden="true">
          {directions.map((direction) => (
            <Image
              src={
                frames[`../assets/img/tampon/tampon-${direction}.png`].default
              }
              alt=""
              widths={[200, 300, 400]}
              sizes="(min-width: 961px) 22vw, 150px"
              loading={direction === "c" ? "eager" : "lazy"}
              data-lean={direction}
              class:list={{ on: direction === "c" }}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<script src="../scripts/hero-demo.ts"></script>
<script src="../scripts/tampon.ts"></script>

<style>
  .hero-band {
    container: hero / inline-size;
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: linear-gradient(#f8ebdb 55%, #dcc6af);
    color: var(--ink);
  }
  .desk {
    position: absolute;
    inset: 0 auto auto 0;
    z-index: -1;
    width: 250%;
    max-width: none;
    height: auto;
    mask-image: linear-gradient(#000 60%, transparent);
  }
  .inner {
    display: flex;
    flex-direction: column;
    width: min(1120px, 100% - 2 * clamp(16px, 5vw, 56px));
    margin-inline: auto;
    padding-bottom: clamp(56px, 8vw, 104px);
  }

  nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 12px 6px;
    align-items: start;
  }
  .brand {
    margin-top: 18px;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.3rem;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .brand span {
    color: var(--stamp);
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tab {
    display: block;
    padding: 22px 16px 10px;
    border-radius: 0 0 3px 3px;
    background: var(--paper);
    box-shadow: 0 2px 6px -2px rgb(60 40 20 / 0.35);
    font-weight: 600;
    text-decoration: none;
    translate: 0 -6px;
    transition: translate 0.2s;
  }
  .tab:hover {
    translate: 0 0;
  }

  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 72px;
    margin-top: clamp(32px, 6vw, 72px);
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero-text .label {
    color: var(--ink);
  }
  .hero-text .lead {
    font-size: 1.2rem;
  }
  .cta {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--display);
    font-weight: 600;
    text-decoration: none;
    background: var(--ink);
    color: var(--bg);
    padding: 14px 22px;
    border-radius: 2px;
  }
  .cta:hover {
    background: var(--hl);
    color: var(--on-hl);
  }

  .demo {
    position: relative;
  }
  .sheet {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(18px, 3vw, 30px);
    background:
      linear-gradient(rgb(228 236 223 / 0.84), rgb(228 236 223 / 0.84)),
      var(--texture) center / 600px;
    transform: rotate(-1.2deg);
    box-shadow:
      0 1px 2px rgb(60 40 20 / 0.2),
      0 18px 40px -18px rgb(60 40 20 / 0.5);
  }
  .sheet-head {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 0.78em;
    color: var(--muted);
    border-bottom: 1px dashed color-mix(in srgb, var(--ink) 25%, transparent);
    padding-bottom: 12px;
  }
  .reqs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .reqs li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 14px;
    align-items: baseline;
  }
  .req {
    --p: 1;
    background-image: linear-gradient(var(--hl), var(--hl));
    background-repeat: no-repeat;
    background-size: calc(var(--p) * 100%) 100%;
    color: color-mix(in srgb, var(--on-hl) calc(var(--p) * 100%), var(--ink));
    padding: 0.05em 0.25em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .verdict {
    font-family: var(--mono);
    font-size: 0.76em;
    white-space: nowrap;
  }
  .verdict.ok {
    color: var(--ok);
  }
  .verdict.warn {
    color: var(--warn);
  }
  .verdict.no {
    color: var(--no);
  }
  .stamp {
    align-self: flex-end;
    margin-top: auto;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.8em;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--stamp);
    border: 2px solid var(--stamp);
    border-radius: 4px;
    padding: 8px 12px;
    transform: rotate(-4deg);
  }
  .sheet-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8em;
    color: var(--muted);
  }

  .tampon {
    position: absolute;
    right: -12px;
    top: -92px;
    width: 150px;
    aspect-ratio: 1;
    pointer-events: none;
  }
  .tampon img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .tampon img:not(.on) {
    visibility: hidden;
  }

  @container hero (width > 960px) {
    .desk,
    .inner {
      --u: min(1cqw, 1.55svh, 16px);
    }
    .desk {
      left: calc(100cqw - 100 * var(--u));
      width: calc(114 * var(--u));
      mask-image: linear-gradient(to right, transparent, #000 8%);
    }
    .inner {
      min-height: calc(62 * var(--u));
    }
    .hero-text {
      width: calc(
        100cqw - 53 * var(--u) -
          max(clamp(16px, 5cqw, 56px), (100cqw - 1120px) / 2)
      );
    }
    .hero-text h1 {
      font-size: clamp(2.7rem, 6.2 * var(--u), 6.2rem);
    }
    .demo {
      position: absolute;
      left: calc(100cqw - 49.3 * var(--u));
      top: calc(7.7 * var(--u));
      width: calc(45 * var(--u));
    }
    .sheet {
      min-height: calc(52 * var(--u));
      padding: calc(3.2 * var(--u));
      font-size: clamp(1rem, 1.6 * var(--u), 1.35rem);
      transform: rotate(-1.7deg);
    }
    .reqs li {
      grid-template-columns: max-content minmax(0, 1fr);
    }
    .req {
      white-space: nowrap;
    }
    .verdict {
      justify-self: end;
      text-align: right;
      white-space: normal;
    }
    .tampon {
      left: calc(-14 * var(--u));
      right: auto;
      top: calc(30 * var(--u));
      width: calc(22 * var(--u));
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .req {
      --p: 0;
    }
    :global(.js) .verdict,
    :global(.js) .stamp {
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tab {
      transition: none;
    }
  }
  @media (hover: none), (pointer: coarse) {
    .tampon img:not(.on) {
      display: none;
    }
  }
  @media (max-width: 600px) {
    nav {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "tabs tabs" "brand lang";
      row-gap: 20px;
    }
    nav ul {
      grid-area: tabs;
      gap: 4px;
    }
    .tab {
      padding: 20px 8px 7px;
      font-size: 0.82rem;
    }
    .brand {
      grid-area: brand;
      align-self: center;
      margin-top: 0;
    }
    .lang {
      grid-area: lang;
      padding: 6px 10px;
      border-radius: 3px;
      translate: none;
    }
  }
  @media (max-width: 480px) {
    .reqs li {
      grid-template-columns: minmax(0, 1fr);
    }
    .verdict {
      white-space: normal;
    }
  }
</style>
