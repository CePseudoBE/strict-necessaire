---
import { translations } from "../i18n/ui";

const t = translations(Astro.currentLocale).duo;
---

<section id="nous">
  <div class="intro" data-reveal>
    <p class="label">{t.label}</p>
    <h2>{t.title}</h2>
    <p>{t.intro}</p>
  </div>
  <div class="duo">
    {t.people.map((person) => (
      <article data-reveal>
        <p class="label">{person.role}</p>
        <h3>{person.name}</h3>
        <p>{person.bio}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .duo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px);
  }
  .duo article {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: clamp(24px, 3vw, 36px);
    background: var(--paper);
    box-shadow:
      0 1px 2px rgb(20 30 25 / 0.12),
      0 14px 30px -18px rgb(20 30 25 / 0.45);
    rotate: -0.6deg;
  }
  .duo article:nth-child(2) {
    rotate: 0.5deg;
    translate: 0 18px;
  }
  .duo article::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--texture) center / 600px;
    opacity: 0.45;
    mix-blend-mode: soft-light;
  }
  .duo h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 800;
  }
  .duo .label {
    color: var(--stamp);
  }
  .duo p:not(.label) {
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .duo {
      grid-template-columns: minmax(0, 1fr);
    }
    .duo article:nth-child(2) {
      translate: none;
    }
  }
</style>
