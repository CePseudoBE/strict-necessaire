---
import { Image } from "astro:assets";
import etape1 from "../assets/img/etape-1.png";
import etape2 from "../assets/img/etape-2.png";
import etape3 from "../assets/img/etape-3.png";
import etape4 from "../assets/img/etape-4.png";
import etape5 from "../assets/img/etape-5.png";

const steps = [
  {
    image: etape1,
    alt: "Enveloppe ouverte posée sur un bureau, une lettre dépasse.",
    title: "Le mail arrive",
    text: "On part du message du client, tel qu'il est.",
  },
  {
    image: etape2,
    alt: "Plans de bâtiment réunis par un trombone.",
    title: "On joint les pièces",
    text: "Plans, métrés, cahier des charges : tout ce qui accompagne la demande.",
  },
  {
    image: etape3,
    alt: "Cinq classeurs verts alignés, l'un d'eux tiré vers le bas.",
    title: "On choisit les PV",
    text: "Vous sélectionnez les procès-verbaux à comparer.",
  },
  {
    image: etape4,
    alt: "Trois notes adhésives jaunes et un stylo.",
    title: "Quelques questions",
    text: "L'IA analyse, puis demande au spécialiste ce qu'elle ne peut pas trancher.",
  },
  {
    image: etape5,
    alt: "Dossier vert marqué d'un tampon violet.",
    title: "Le PDF technique",
    text: "Un document prêt à relire et à envoyer.",
  },
];
---

<section id="artemis">
  <div class="intro" data-reveal>
    <p class="label">Ce qu'on a construit</p>
    <h2>Artemis vérifie une demande client contre vos PV.</h2>
    <p>
      Chaque demande doit être comparée, ligne par ligne, aux procès-verbaux qui
      disent ce que vous avez le droit de vendre. À la main, c'est long et
      rébarbatif. Artemis fait la lecture, votre spécialiste garde la décision.
    </p>
  </div>
  <ol class="steps">
    {steps.map((step) => (
      <li data-reveal>
        <Image
          src={step.image}
          alt={step.alt}
          widths={[200, 320, 480]}
          sizes="(max-width: 480px) 88px, (max-width: 860px) 45vw, 210px"
        />
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>

  <div
    class="seg"
    data-reveal
    role="group"
    aria-label="Choisir votre point de vue"
  >
    <button
      type="button"
      id="seg-dir"
      aria-pressed="true"
      data-panel="args-dir"
    >
      Vous dirigez
    </button>
    <button
      type="button"
      id="seg-met"
      aria-pressed="false"
      data-panel="args-met"
    >
      Vous traitez les demandes
    </button>
  </div>
  <div class="panels" data-reveal>
    <div class="args" id="args-dir">
      <div>
        <h3>Vous répondez à plus d'offres</h3>
        <p>
          Aujourd'hui, on trie et on ne répond qu'à certaines demandes, faute de
          temps. Avec la vérification préparée, vous pouvez toutes les traiter.
        </p>
      </div>
      <div>
        <h3>Des heures d'expert rendues</h3>
        <p>
          Le temps de vos profils les plus chers passe de la lecture de PV à la
          décision et à la relation client.
        </p>
      </div>
      <div>
        <h3>Une réponse défendable</h3>
        <p>
          Chaque conclusion renvoie au PV qui la justifie. On sait pourquoi on a
          dit oui ou non.
        </p>
      </div>
    </div>
    <div class="args" id="args-met">
      <div>
        <h3>Fini la relecture ligne par ligne</h3>
        <p>
          L'outil repère les exigences dans le mail et les pièces, et les
          confronte aux PV choisis.
        </p>
      </div>
      <div>
        <h3>On vous demande l'essentiel</h3>
        <p>
          Quelques questions courtes, sur les points où votre jugement compte
          vraiment.
        </p>
      </div>
      <div>
        <h3>Le document est déjà rédigé</h3>
        <p>
          Vous relisez et corrigez un PDF technique au lieu de partir d'une page
          blanche.
        </p>
      </div>
    </div>
  </div>
</section>

<script src="../scripts/viewpoint-toggle.ts"></script>

<style>
  .steps {
    list-style: none;
    counter-reset: s;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
  }
  .steps li {
    counter-increment: s;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .steps li::before {
    content: counter(s, decimal-leading-zero);
    margin-top: 6px;
    padding-top: 10px;
    border-top: 2px solid var(--ink);
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--stamp);
  }
  .steps img {
    order: -1;
    width: 100%;
    height: auto;
    border-radius: 2px;
  }
  .steps p {
    font-size: 0.95rem;
    color: var(--muted);
  }

  .seg {
    display: inline-flex;
    align-self: flex-start;
    border: 1px solid var(--ink);
    border-radius: 2px;
  }
  .seg button {
    background: none;
    border: 0;
    padding: 10px 16px;
    font-family: var(--display);
    font-weight: 600;
  }
  .seg button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--bg);
  }
  .args {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }
  .panels {
    display: grid;
    gap: 28px;
  }
  :global(.js) .panels > .args {
    grid-area: 1 / 1;
  }
  .args[hidden] {
    display: grid;
    visibility: hidden;
  }
  :global(html:not(.js)) .seg {
    display: none;
  }
  .args div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .args p {
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .args {
      grid-template-columns: minmax(0, 1fr);
    }
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
    .steps li {
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 4px 16px;
      align-content: start;
    }
    .steps li > * {
      grid-column: 2;
    }
    .steps li > img {
      grid-column: 1;
      grid-row: 1 / span 3;
    }
    .seg button {
      padding: 10px 12px;
      font-size: 0.92rem;
    }
    .steps li::before {
      grid-column: 2;
      margin-top: 0;
    }
  }
</style>
