---
import { Image } from "astro:assets";
import etape1 from "../assets/img/etape-1.png";
import etape2 from "../assets/img/etape-2.png";
import etape3 from "../assets/img/etape-3.png";
import etape4 from "../assets/img/etape-4.png";
import etape5 from "../assets/img/etape-5.png";
import { translations } from "../i18n/ui";

const t = translations(Astro.currentLocale).artemis;
const images = [etape1, etape2, etape3, etape4, etape5];
---

<section id="artemis">
  <div class="intro" data-reveal>
    <p class="label">{t.label}</p>
    <h2>{t.title}</h2>
    <p>{t.intro}</p>
  </div>
  <ol class="steps">
    {t.steps.map((step, index) => (
      <li data-reveal>
        <Image
          src={images[index]}
          alt={step.alt}
          widths={[200, 320, 480]}
          sizes="(max-width: 480px) 88px, (max-width: 860px) 45vw, 210px"
        />
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>

  <div class="seg" data-reveal role="group" aria-label={t.viewpointLabel}>
    {t.viewpoints.map((viewpoint, index) => (
      <button
        type="button"
        id={`seg-${viewpoint.id}`}
        aria-pressed={index === 0 ? "true" : "false"}
        data-panel={`args-${viewpoint.id}`}
      >
        {viewpoint.label}
      </button>
    ))}
  </div>
  <div class="panels" data-reveal>
    {t.viewpoints.map((viewpoint) => (
      <div class="args" id={`args-${viewpoint.id}`}>
        {viewpoint.args.map((argument) => (
          <div>
            <h3>{argument.title}</h3>
            <p>{argument.text}</p>
          </div>
        ))}
      </div>
    ))}
  </div>
</section>

<script src="../scripts/viewpoint-toggle.ts"></script>

<style>
  .steps {
    list-style: none;
    counter-reset: s;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
  }
  .steps li {
    counter-increment: s;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .steps li::before {
    content: counter(s, decimal-leading-zero);
    margin-top: 6px;
    padding-top: 10px;
    border-top: 2px solid var(--ink);
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--stamp);
  }
  .steps img {
    order: -1;
    width: 100%;
    height: auto;
    border-radius: 2px;
  }
  .steps p {
    font-size: 0.95rem;
    color: var(--muted);
  }

  .seg {
    display: inline-flex;
    align-self: flex-start;
    border: 1px solid var(--ink);
    border-radius: 2px;
  }
  .seg button {
    background: none;
    border: 0;
    padding: 10px 16px;
    font-family: var(--display);
    font-weight: 600;
  }
  .seg button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--bg);
  }
  .args {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }
  .panels {
    display: grid;
    gap: 28px;
  }
  :global(.js) .panels > .args {
    grid-area: 1 / 1;
  }
  .args[hidden] {
    display: grid;
    visibility: hidden;
  }
  :global(html:not(.js)) .seg {
    display: none;
  }
  .args div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .args p {
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .args {
      grid-template-columns: minmax(0, 1fr);
    }
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
    .steps li {
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 4px 16px;
      align-content: start;
    }
    .steps li > * {
      grid-column: 2;
    }
    .steps li > img {
      grid-column: 1;
      grid-row: 1 / span 3;
    }
    .seg button {
      padding: 10px 12px;
      font-size: 0.92rem;
    }
    .steps li::before {
      grid-column: 2;
      margin-top: 0;
    }
  }
</style>
