---
import { translations } from "../i18n/ui";

const t = translations(Astro.currentLocale).refus;
---

<section id="refus">
  <div class="intro" data-reveal>
    <p class="label">{t.label}</p>
    <h2>{t.title}</h2>
  </div>
  <ul class="refus">
    {t.items.map((item) => (
      <li data-reveal>
        <h3>
          <s data-strike>{item.title}</s>
        </h3>
        <p>{item.text}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  #refus {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: 28px clamp(32px, 6vw, 96px);
    align-items: start;
  }
  #refus .intro {
    position: sticky;
    top: 32px;
  }
  .refus {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .refus li {
    display: grid;
    gap: 10px;
    padding-block: 28px;
    border-bottom: 1px solid var(--line);
  }
  .refus h3 {
    font-size: clamp(1.35rem, 2.3vw, 1.75rem);
  }
  .refus s {
    --strike: 1;
    padding-inline: 0.08em;
    text-decoration: none;
    background: linear-gradient(var(--no), var(--no)) 0 58% /
      calc(var(--strike) * 100%) 0.11em no-repeat;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .refus p {
    color: var(--muted);
  }

  @media (max-width: 860px) {
    #refus {
      grid-template-columns: minmax(0, 1fr);
    }
    #refus .intro {
      position: static;
    }
  }
</style>
